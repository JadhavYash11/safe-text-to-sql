# Choose offline (no model), ollama (free local API), or openai.
LLM_PROVIDER=offline
# For free local generation: install Ollama, run `ollama pull llama3.2:3b`, then set LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=duckdb:///data/text2sql.duckdb
# PostgreSQL example (do not use an administrator account):
# DATABASE_URL=postgresql+psycopg://text2sql_reader:password@localhost:5432/analytics
# SEED_DEMO_DATA=false
MAX_ROWS=1000
MAX_ESTIMATED_ROWS=100000
MAX_SUBQUERY_DEPTH=3
